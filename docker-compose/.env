# 网络配置
SUBNET=10.10.0.0/16

# 以下为主机映射端口（容器内端口不变，与官方镜像默认一致），选用高位端口以降低与本机常用服务冲突概率

# MySQL
MYSQL_ROOT_PASSWORD=root123
MYSQL_PORT=13306

# Redis
REDIS_PORT=16379
REDIS_PASSWORD=redis123

# Nacos（主端口 8848，gRPC 9848，与客户端默认约定一致）
NACOS_PORT=8848
NACOS_GRPC_PORT=9848

# RocketMQ
ROCKETMQ_NAMESRV_PORT=19876
ROCKETMQ_BROKER_PORT=20911
ROCKETMQ_BROKER_VIP_PORT=20909

# Elasticsearch（与 SUBNET 同网段；供 SkyWalking 等用固定 IP，避免容器内 Netty DNS 解析超时）
ES_CONTAINER_IP=10.10.5.20
ES_PORT=19200
ES_TRANSPORT_PORT=19300
ES_PASSWORD=elastic123

# MinIO
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# XXL-Job
XXL_JOB_PORT=18081
XXL_JOB_DB=xxl_job

# SkyWalking
SKYWALKING_GRPC_PORT=21800
SKYWALKING_HTTP_PORT=22800
SKYWALKING_UI_PORT=18083
SKYWALKING_AGENT_DIR=./skywalking/agent

# Sentinel
SENTINEL_PORT=18858
SENTINEL_USERNAME=sentinel
SENTINEL_PASSWORD=sentinel123

# Seata（仅宿主机映射端口；容器内 TC 8091、控制台 HTTP 7091）
SEATA_PORT=19091
SEATA_CONSOLE_PORT=19092

# Canal（Server 数据口；Admin Web 控制台）
CANAL_PORT=21111
CANAL_ADMIN_PORT=18089
CANAL_ADMIN_PASSWORD=123456

# Prometheus + Grafana（监控面板）
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
